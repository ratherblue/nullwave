---
const msg = '» Now booking Q4 2002 » New: Aquaform microsite » Best with sound on » Thanks for visiting Nullwave »';
---
<footer class="statusbar px">
  <span class="status-tag">Status</span>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track"><span>{msg}</span><span>{msg}</span></div>
  </div>
  <button id="sound-toggle" class="sound px" type="button" aria-pressed="true" aria-label="Toggle interface sounds">
    <span class="eq"><i></i><i></i><i></i></span>
    <span class="sound-label">Sound on</span>
  </button>
  <span id="clock" class="clock">--:--:--</span>
</footer>

---
import { href, unbase } from '../lib/url';
const path = unbase(Astro.url.pathname).replace(/\/$/, '') || '/';
const items = [
  ['/', 'Home'],
  ['/work', 'Work'],
  ['/about', 'About'],
  ['/contact', 'Contact'],
];
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<header class="topbar">
  <a href={href('/')} class="brand" aria-label="Nullwave home">
    <span class="orb"></span>
    <span class="brand-text">
      <span class="logo">
        Null<em>//</em>Wave
      </span>
      <span class="ver px">Interactive portfolio v2.0.2</span>
    </span>
  </a>
  <nav class="nav" aria-label="Main">
    {items.map(([item, label]) => (
      <a
        href={href(item)}
        class:list={['btn', 'px', isActive(item) ? 'btn-blue' : 'btn-silver']}
        aria-current={isActive(item) ? 'page' : undefined}
        data-sfx="hover"
      >
        {label}
      </a>
    ))}
  </nav>
</header>

---
interface Props {
  title: string;
  controls?: boolean;
  chrome?: boolean;
  class?: string;
}
const { title, controls = false, chrome = false, class: cls } = Astro.props;
---

<section class:list={['window', cls]}>
  <div class:list={['window-title', 'px', chrome && 'is-chrome']}>
    <span>{title}</span>
    {controls && <span aria-hidden="true">_ □ ×</span>}
  </div>
  <slot />
</section>

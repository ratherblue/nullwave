---
import Base from '../layouts/Base.astro';
import Rings from '../components/Rings.astro';
import Window from '../components/Window.astro';

const news = [
  ['09.02', 'AQUAFORM microsite goes live.'],
  ['07.02', 'Speaking at Vector Night, Rotterdam.'],
  ['05.02', 'Site v2 rebuilt in Flash MX.'],
];
---
<Base scene="SCENE 01 · HOME">
  <div class="home">
    <Rings />
    <div class="hero">
      <p class="eyebrow px">// WELCOME TO THE EXPERIENCE</p>
      <h1 class="display flicker">KAI<br />MORROW</h1>
      <p class="tagline px">INTERFACE · MOTION · CODE</p>
      <p class="lede">Independent interactive designer building microsites, kiosks and motion idents out of vectors, ActionScript and too much coffee. Based somewhere between the timeline and the stage.</p>
      <div class="actions">
        <a href="/work" class="btn btn-blue btn-lg px" data-sfx="hover">View work ›</a>
        <a href="/contact" class="btn btn-ghost btn-lg px" data-sfx="hover">Get in touch</a>
      </div>
    </div>
    <Window title="NEWS.TXT" class="news">
      <ul class="news-list">
        {news.map(([d, t]) => <li><time class="px">{d}</time><span>{t}</span></li>)}
      </ul>
    </Window>
  </div>
</Base>
